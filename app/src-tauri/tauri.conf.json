{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STAR Stream",
  "version": "0.1.4",
  "identifier": "corp.star.stream",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "STAR // STREAM",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#07080A",
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "bin/ffmpeg.exe": "bin/ffmpeg.exe"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDRTkyN0E2QzE4Q0VCMUEKUldRYTY0ekJwaWZwM0d1cTk4WEFlZi9OSFNXRHRSNFpqckpaN0pDZzc1OStOQktCK3hvZlFXdEwK",
      "endpoints": [
        "https://github.com/PlebeLucas/star-stream/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
